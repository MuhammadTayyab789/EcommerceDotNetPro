UPDATE dbo.KycUpdate 
SET 
    RetryCount = CASE 
                   WHEN DATEDIFF(DAY, ModifiedAt, GETDATE()) > 3 THEN ISNULL(RetryCount, 0) + 1
                   ELSE RetryCount 
                 END,
    ModifiedAt = CASE 
                   WHEN DATEDIFF(DAY, ModifiedAt, GETDATE()) > 3 THEN GETDATE()
                   ELSE ModifiedAt 
                 END
WHERE 
    CustomerID_Number = @CNIC 
    AND ISNULL(IsKycUpdated, 0) = 0;







